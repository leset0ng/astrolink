<template>
  <!-- THESIS: A watch-sized link bench, with real radio state ahead of actions.
       OWN-WORLD: OLED black, white labels, muted blue controls, green connection state.
       STORY: Advertise on one watch, scan and connect on the other, then verify an echo.
       FIRST VIEWPORT: Centered name, connection status, two large scan/advertise controls,
       and the beginning of the peer list; results and cleanup follow in the same scroll.
       FORM: Parent-pinned single-page Operate wireframe; no concept lottery applies.
       FINISH: Build, controller checks, simulator inspection where available, scoped design record. -->
  <div class="page">
    <list class="content">
      <list-item type="heading" class="heading">
        <text class="title">Astrolink</text>
        <text class="status {{connected ? 'connected' : ''}}">{{status}}</text>
        <text if="{{busy}}" class="progress">{{busy}}中…</text>
      </list-item>
      <list-item type="controls" class="controls">
        <input class="action {{scanning ? 'selected' : ''}}" type="button"
          value="{{scanning ? '停止扫描' : '扫描'}}" disabled="{{!ready || busy !== ''}}" onclick="toggleScan" />
        <input class="action {{advertising ? 'selected' : ''}}" type="button"
          value="{{advertising ? '停止广播' : '广播'}}" disabled="{{!ready || busy !== ''}}" onclick="toggleAdvertising" />
      </list-item>
      <list-item type="peers-heading" class="section-heading">
        <text class="section-title">附近设备</text>
        <text class="section-detail">{{peers.length}} 台</text>
      </list-item>
      <list-item if="{{peers.length === 0}}" type="empty" class="empty">
        <text class="hint">{{scanning ? '正在寻找 chat 服务…' : '另一台开启广播后，点击扫描'}}
        </text>
      </list-item>
      <list-item for="{{peers}}" type="peer" class="peer" onclick="connectPeer($item.peerId)">
        <div class="peer-copy">
          <text class="peer-id">{{$item.peerId}}</text>
          <text class="peer-detail">{{$item.rssi}} dBm · {{$item.dataHex}}</text>
        </div>
        <text class="connect-label">连接</text>
      </list-item>
      <list-item type="link-heading" class="section-heading">
        <text class="section-title">消息测试</text>
        <text class="section-detail">{{connected ? maxMessageBytes + ' B' : '待连接'}}</text>
      </list-item>
      <list-item type="metrics" class="metrics">
        <text class="counter">已发 {{sent}}</text>
        <text class="counter">已收 {{received}}</text>
      </list-item>
      <list-item type="ping" class="full-control">
        <input class="primary" type="button" value="发送 Ping"
          disabled="{{!connected || busy !== ''}}" onclick="sendPing" />
      </list-item>
      <list-item type="tests" class="full-control">
        <input class="secondary" type="button" value="二进制与长度测试"
          disabled="{{!connected || busy !== ''}}" onclick="runTests" />
      </list-item>
      <list-item type="result" class="result">
        <text class="result-copy">{{result}}</text>
      </list-item>
      <list-item type="disconnect" class="full-control">
        <input class="secondary" type="button" value="断开连接"
          disabled="{{!connected || busy !== ''}}" onclick="disconnect" />
      </list-item>
      <list-item type="service-test" class="full-control">
        <input class="secondary" type="button" value="服务名字节测试"
          disabled="{{!ready || busy !== ''}}" onclick="testServiceNames" />
      </list-item>
      <list-item type="session" class="full-control">
        <input class="quiet" type="button" value="{{ready ? '关闭 Session' : '重新检测'}}"
          disabled="{{busy !== ''}}" onclick="toggleSession" />
      </list-item>
      <list-item type="log-heading" class="section-heading">
        <text class="section-title">最近事件</text>
        <text class="section-detail">{{log.length}} / 20</text>
      </list-item>
      <list-item for="{{log}}" type="log" class="log-entry">
        <text class="log-copy {{$item.failed ? 'failed' : ''}}">{{$item.message}}</text>
      </list-item>
      <list-item type="footer" class="footer">
        <text class="hint">回包由对端应用确认\n退出应用会释放 Session</text>
      </list-item>
    </list>
  </div>
</template>

<script>
import { getController, destroyController } from "../../ts/runtime"

let unsubscribe = null

export default {
  private: {
    supported: false,
    ready: false,
    status: "正在检测模块",
    busy: "",
    scanning: false,
    advertising: false,
    connected: false,
    peerId: "",
    maxMessageBytes: 0,
    sent: 0,
    received: 0,
    result: "两台设备打开本应用",
    peers: [],
    log: []
  },
  onInit() {
    if (unsubscribe) unsubscribe()
    unsubscribe = getController().subscribe(view => {
      Object.keys(view).forEach(key => { this[key] = view[key] })
    })
  },
  onDestroy() {
    if (unsubscribe) unsubscribe()
    unsubscribe = null
    destroyController()
  },
  toggleScan() { return getController().toggleScan() },
  toggleAdvertising() { return getController().toggleAdvertising() },
  connectPeer(peerId) { return getController().connect(peerId) },
  sendPing() { return getController().ping() },
  runTests() { return getController().testBinaryAndLimits() },
  disconnect() { return getController().disconnect() },
  testServiceNames() { return getController().testServiceNames() },
  toggleSession() {
    const controller = getController()
    if (this.ready) return controller.closeSession()
    controller.reopen()
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  background-color: #000000;
  flex-direction: column;
}
