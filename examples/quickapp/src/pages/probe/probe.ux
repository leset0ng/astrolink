<template>
  <div class="page">
    <list class="content">
      <list-item type="heading" class="heading">
        <text class="title">Astrolink 探针</text>
        <text class="status {{failed ? 'failed' : ''}}">{{status}}</text>
      </list-item>
      <list-item type="step" class="step">
        <text class="step-name">{{step}}</text>
        <text class="detail">{{detail}}</text>
      </list-item>
      <list-item type="count" class="count">
        <text class="passed">已通过 {{passed}} 项</text>
        <text class="capabilities">{{capabilities}}</text>
      </list-item>
      <list-item for="{{log}}" type="log" class="log">
        <text class="log-copy {{$item.failed ? 'failed' : ''}}">{{$item.message}}</text>
      </list-item>
      <list-item type="footer" class="footer">
        <text class="detail">自动逐步执行，超时报告失败
退出页面会关闭所属 Session</text>
      </list-item>
    </list>
  </div>
</template>

<script>
import brightness from "@system.brightness"
import { NativeProbeRunner } from "../../ts/probe-runner"

let activeRunner = null

export default {
  private: {
    status: "页面已加载",
    step: "准备原生测试",
    detail: "每一步最长等待 10 秒",
    capabilities: "尚未读取能力",
    passed: 0,
    finished: false,
    failed: false,
    log: []
  },
  onInit() {
    console.log('[AstrolinkProbe] {"event":"page-init"}')
    activeRunner = new NativeProbeRunner(view => {
      this.status = view.status
      this.step = view.step
      this.detail = view.detail
      this.capabilities = view.capabilities
      this.passed = view.passed
      this.finished = view.finished
      this.failed = view.failed
      this.log = view.log
      if (view.finished) brightness.setKeepScreenOn({ keepScreenOn: false })
    })
    const runner = activeRunner
    new Promise((resolve, reject) => {
      brightness.setKeepScreenOn({
        keepScreenOn: true,
        success: resolve,
        fail: (data, code) => reject(new Error(`无法保持测试亮屏 (${code}): ${String(data)}`))
      })
    }).then(() => {
      if (activeRunner !== runner) {
        brightness.setKeepScreenOn({ keepScreenOn: false })
        return
      }
      return runner.start()
    }).catch(error => {
      this.status = "探针执行失败"
      this.detail = String(error)
      this.failed = true
      this.finished = true
      console.error('[AstrolinkProbe] ' + JSON.stringify({ event: 'runner-error', error: String(error) }))
    })
  },
  onDestroy() {
    console.log('[AstrolinkProbe] {"event":"page-destroy"}')
    const runner = activeRunner
    activeRunner = null
    brightness.setKeepScreenOn({ keepScreenOn: false })
    if (runner) runner.destroy().catch(error => {
      console.error('[AstrolinkProbe] ' + JSON.stringify({ event: 'destroy-error', error: String(error) }))
    })
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  background-color: #000000;
  flex-direction: column;
}
.content {
  width: 100%;
  height: 100%;
  padding-left: 12px;
  padding-right: 12px;
}
.heading {
  height: 105px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.title {
  height: 36px;
  font-size: 24px;
  color: #ffffff;
  text-align: center;
}
.status {
  height: 30px;
  font-size: 19px;
  color: #8fe0b5;
  text-align: center;
}
.step {
  height: 126px;
  flex-direction: column;
  justify-content: center;
}
.step-name {
  height: 38px;
  font-size: 21px;
  color: #ffffff;
}
.detail {
  width: 100%;
  font-size: 16px;
  line-height: 24px;
  color: #c1c9d4;
}
.count {
  height: 100px;
  flex-direction: column;
  justify-content: center;
}
.passed {
  height: 34px;
  font-size: 20px;
  color: #a7c9f6;
}
.capabilities {
  width: 100%;
  font-size: 15px;
  line-height: 23px;
  color: #c1c9d4;
}
.log {
  height: 52px;
  align-items: center;
}
.log-copy {
  width: 100%;
  font-size: 16px;
  line-height: 23px;
  color: #c1c9d4;
}
.failed {
  color: #ffb5a7;
}
.footer {
  height: 110px;
  align-items: center;
}
</style>
