  font-size: 30px;
  font-weight: 600;
  color: #ffffff;
  height: 38px;
  line-height: 38px;
}
.status {
  font-size: 18px;
  color: #c1c9d4;
  height: 28px;
  line-height: 28px;
  text-align: center;
  lines: 1;
}
.connected { color: #8fe0b5; }
.progress {
  color: #a7c9f6;
  font-size: 15px;
  height: 20px;
}
.controls {
  height: 62px;
  align-items: center;
  justify-content: space-between;
}
.action {
  width: 47%;
  height: 52px;
  border-radius: 14px;
  background-color: #253c59;
  color: #ecf3ff;
  font-size: 20px;
}
.selected {
  background-color: #3b5d85;
}
.section-heading {
  height: 54px;
  padding-top: 18px;
  align-items: center;
  justify-content: space-between;
}
.section-title {
  color: #ffffff;
  font-size: 20px;
  font-weight: 600;
  line-height: 28px;
}
.section-detail {
  color: #b5bfcc;
  font-size: 15px;
  line-height: 28px;
}
.empty {
  height: 66px;
  align-items: center;
}
.hint {
  width: 100%;
  color: #aeb8c6;
  font-size: 17px;
  line-height: 24px;
}
.peer {
  height: 78px;
  align-items: center;
  border-bottom-width: 1px;
  border-bottom-color: #26303d;
}
.peer-copy {
  width: 76%;
  flex-direction: column;
}
.peer-id {
  color: #ffffff;
  font-size: 18px;
  lines: 1;
  text-overflow: ellipsis;
  height: 28px;
}
.peer-detail {
  color: #b5bfcc;
  font-size: 15px;
  lines: 1;
  text-overflow: ellipsis;
  height: 24px;
}
.connect-label {
  width: 24%;
  color: #a7c9f6;
  font-size: 18px;
  text-align: right;
}
.metrics {
  height: 40px;
  align-items: center;
  justify-content: space-between;
}
.counter {
  color: #c1c9d4;
  font-size: 18px;
}
.full-control {
  height: 64px;
  align-items: center;
}
.primary, .secondary, .quiet {
  width: 100%;
  height: 54px;
  border-radius: 14px;
  font-size: 20px;
}
.primary {
  color: #ffffff;
  background-color: #355f91;
}
.secondary {
  color: #e5ecf5;
  background-color: #222a35;
}
.quiet {
  color: #bdcadb;
  background-color: #151a21;
}
.result {
  padding-top: 8px;
  padding-bottom: 12px;
}
.result-copy {
  width: 100%;
  color: #cbd9eb;
  font-size: 17px;
  line-height: 25px;
}
.log-entry {
  padding-top: 8px;
  padding-bottom: 8px;
  border-bottom-width: 1px;
  border-bottom-color: #1c232d;
}
.log-copy {
  width: 100%;
  color: #b8c4d4;
  font-size: 16px;
  line-height: 23px;
}
.failed { color: #ffb3a6; }
.footer {
  padding-top: 18px;
  padding-bottom: 34px;
}
@media (width <= 200) {
  .content { padding-left: 6px; padding-right: 6px; }
  .title { font-size: 25px; }
  .action { font-size: 17px; }
  .section-title { font-size: 18px; }
  .section-detail { font-size: 13px; }
  .hint, .result-copy { font-size: 16px; }
  .peer-id { font-size: 16px; }
  .peer-detail { font-size: 13px; }
  .connect-label { font-size: 16px; }
  .primary, .secondary, .quiet { font-size: 18px; }
}
</style>
